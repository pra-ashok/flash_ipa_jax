  edge_positions [pos="1000,1120!", width=2.0833, height=0.4167, label="t in Å", color="#2e8578", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=15, fontcolor="#2e8578"];
  single_state:s -> ipa:n [color="#3768a3", arrowhead=normal];
  route_58_0 [pos="250,805!", shape=point, width=0, height=0, label="", style=invis];
  pair_state:s -> route_58_0 [color="#8360aa", arrowhead=none];
  route_58_0 -> ipa:w [color="#8360aa", arrowhead=normal];
  route_61_0 [pos="1200,805!", shape=point, width=0, height=0, label="", style=invis];
  geom_state:s -> route_61_0 [color="#2e8578", arrowhead=none];
  route_61_0 -> ipa:e [color="#2e8578", arrowhead=normal];
  ipa:s -> ipa_add:n [color="#3768a3", arrowhead=normal];
  route_65_0 [pos="965,910!", shape=point, width=0, height=0, label="", style=invis];
  single_state:e -> route_65_0 [color="#3768a3", arrowhead=none];
  route_67_1 [pos="965,728!", shape=point, width=0, height=0, label="", style=invis];
  route_65_0 -> route_67_1 [color="#3768a3", arrowhead=none];
  route_67_1 -> ipa_add:e [color="#3768a3", arrowhead=normal];
  ipa_add:s -> norm:n [color="#3768a3", arrowhead=normal];
  norm:s -> sequence:n [color="#3768a3", arrowhead=normal];
  sequence:s -> project:n [color="#3768a3", arrowhead=normal];
  project:s -> sequence_add:n [color="#3768a3", arrowhead=normal];
  route_74_0 [pos="940,665!", shape=point, width=0, height=0, label="", style=invis];
  norm:e -> route_74_0 [color="#3768a3", arrowhead=none];
  route_76_1 [pos="940,424!", shape=point, width=0, height=0, label="", style=invis];
