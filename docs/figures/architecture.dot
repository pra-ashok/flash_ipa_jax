  embed:s -> pair_state:n [color="#8360aa", arrowhead=normal];
  single_prep:w -> embed:e [color="#3768a3", arrowhead=normal];
  route_51_0 [pos="1200,1105!", shape=point, width=0, height=0, label="", style=invis];
