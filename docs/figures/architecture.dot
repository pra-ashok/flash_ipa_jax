digraph structure_architecture {
  // Editable layout source. Positions are in points; render with neato -n2.
  graph [layout=neato, overlap=true, splines=line, bgcolor="white",
         outputorder=nodesfirst, pad="0.15", dpi=144, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=18, color="#4c5869", fillcolor="white", penwidth=1.5,
        fixedsize=true, pin=true, margin="0.08,0.05"];
  edge [color="#4c5869", penwidth=1.7, arrowsize=0.8,
        fontname="DejaVu Sans", fontsize=15];
  canvas_sw [pos="0,0!", shape=point, width=0, height=0, label="", style=invis];
  canvas_ne [pos="1440,1370!", shape=point, width=0, height=0, label="", style=invis];
  repeat_panel [pos="720,605!", width=19.4444, height=10.9722, label="", color="#c0c6ce", fillcolor="#fbfcfd", penwidth=1.4];
  title [pos="720,1335!", width=18.0556, height=0.5556, label="Flash IPA JAX · structure refinement", color="#263447", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=30, fontcolor="#263447"];
  subtitle [pos="720,1290!", width=18.0556, height=0.4722, label="Learned residue features + initial orientations and positions → refined 3D geometry", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=18, fontcolor="#4c5869"];
  pair_header [pos="250,1230!", width=5.0000, height=0.5556, label="PAIR CONTEXT", color="#8360aa", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=19, fontcolor="#8360aa"];
  single_header [pos="720,1230!", width=5.0000, height=0.5556, label="SINGLE REPRESENTATION", color="#3768a3", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=19, fontcolor="#3768a3"];
  geom_header [pos="1200,1230!", width=5.6944, height=0.5556, label="RESIDUE COORDINATE SYSTEMS", color="#2e8578", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=19, fontcolor="#2e8578"];
  pair_input [pos="250,1160!", width=4.7222, height=0.9722, label="Optional dense pair input\n[B, N, N, c_z]", color="#8360aa", fillcolor="#f1ebf8"];
  single_input [pos="720,1160!", width=4.7222, height=0.9722, label="Residue features  s\n[B, N, c_s]", color="#3768a3", fillcolor="#eaf2fb"];
  geom_input [pos="1200,1160!", width=5.1389, height=0.9722, label="Orientations R · positions t\n[B, N, 3, 3] · [B, N, 3]", color="#2e8578", fillcolor="#e6f3ef"];
  embed [pos="250,1050!", width=4.7222, height=1.0417, label="EdgeEmbedder\ns + indices + distances", color="#8360aa", fillcolor="#f1ebf8"];
  single_prep [pos="720,1050!", width=4.1667, height=0.6944, label="Apply residue mask", color="#3768a3", fillcolor="#eaf2fb"];
  units [pos="1200,1050!", width=5.1389, height=1.0417, label="Internal coordinates\nt: Å → nm", color="#2e8578", fillcolor="#e6f3ef"];
  block_title [pos="355,965!", width=6.9444, height=0.5278, label="STRUCTURE BLOCK", color="#263447", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=20, fontcolor="#263447"];
  repeat [pos="980,965!", width=4.4444, height=0.5278, label="× L  (default: 6)", color="#263447", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=20, fontcolor="#263447"];
  pair_state [pos="250,910!", width=4.7222, height=0.9028, label="z  or  (z₁, z₂)", color="#8360aa", fillcolor="#f1ebf8"];
  single_state [pos="720,910!", width=3.8889, height=0.9028, label="s", color="#3768a3", fillcolor="#eaf2fb"];
  geom_state [pos="1200,910!", width=4.1667, height=0.9028, label="(R, t)", color="#2e8578", fillcolor="#e6f3ef"];
  ipa [pos="720,805!", width=4.8611, height=0.9167, label="Invariant point attention", color="#3768a3", fillcolor="#eaf2fb"];
  ipa_add [pos="720,728!", width=0.4167, height=0.4167, label="+", color="#3768a3", fillcolor="white", shape=circle, fontsize=25, penwidth=1.7];
  norm [pos="720,665!", width=4.1667, height=0.6944, label="LayerNorm", color="#3768a3", fillcolor="#eaf2fb"];
  sequence [pos="720,575!", width=4.8611, height=0.8611, label="Sequence Transformer", color="#3768a3", fillcolor="#eaf2fb"];
  project [pos="720,492!", width=4.1667, height=0.6944, label="Linear", color="#3768a3", fillcolor="#eaf2fb"];
  sequence_add [pos="720,424!", width=0.4167, height=0.4167, label="+", color="#3768a3", fillcolor="white", shape=circle, fontsize=25, penwidth=1.7];
  node_transition [pos="720,341!", width=4.8611, height=0.9028, label="Node MLP\nresidual + LayerNorm", color="#3768a3", fillcolor="#eaf2fb"];
  geometry_projection [pos="1130,341!", width=4.1667, height=0.9028, label="Linear → 6 values\nlocal rotation / translation", color="#2e8578", fillcolor="#e6f3ef"];
  geometry_compose [pos="1200,250!", width=4.1667, height=0.8056, label="Compose with (R, t)", color="#2e8578", fillcolor="#e6f3ef"];
  edge_update [pos="250,341!", width=4.7222, height=0.9028, label="Edge transition*", color="#8360aa", fillcolor="#f1ebf8"];
  pair_carry [pos="250,250!", width=4.1667, height=0.6944, label="z′  or  (z₁′, z₂′)", color="#8360aa", fillcolor="#f1ebf8"];
  single_carry [pos="720,250!", width=3.3333, height=0.6944, label="s′", color="#3768a3", fillcolor="#eaf2fb"];
  next_block [pos="720,166!", width=17.5000, height=0.5278, label="Carry all three states into the next block · each block has its own weights", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=17, fontcolor="#4c5869"];
  predictions [pos="1200,90!", width=5.5556, height=1.0556, label="Refined orientations and positions\nR: [B, N, 3, 3] · t: [B, N, 3] in Å", color="#2e8578", fillcolor="#e6f3ef"];
  pair_shape [pos="370,90!", width=8.6111, height=0.6250, label="Dense z: [B, N, N, c_z]\nFactors z₁, z₂: each [B, N, r, c_z]", color="#8360aa", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=17, fontcolor="#8360aa"];
  footnote [pos="720,28!", width=19.1667, height=0.6111, label="* Edge transition is skipped in the final block and when pair context is disabled.  B: batch · N: residues · r: factor rank", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=15, fontcolor="#4c5869"];
  pair_input:s -> embed:n [color="#8360aa", arrowhead=normal];
