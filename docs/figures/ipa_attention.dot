digraph ipa_computation {
  // Editable layout source. Positions are in points; render with neato -n2.
  graph [layout=neato, overlap=true, splines=line, bgcolor="white",
         outputorder=nodesfirst, pad="0.15", dpi=144, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=18, color="#4c5869", fillcolor="white", penwidth=1.5,
        fixedsize=true, pin=true, margin="0.08,0.05"];
  edge [color="#4c5869", penwidth=1.7, arrowsize=0.8,
        fontname="DejaVu Sans", fontsize=15];
  canvas_sw [pos="0,0!", shape=point, width=0, height=0, label="", style=invis];
  canvas_ne [pos="1540,1540!", shape=point, width=0, height=0, label="", style=invis];
  execution_panel [pos="770,113!", width=19.7222, height=2.2222, label="", color="#d0d5dc", fillcolor="#f7f8fa", penwidth=1.2];
  title [pos="770,1495!", width=19.7222, height=0.5556, label="Invariant point attention · inside one layer", color="#263447", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=30, fontcolor="#263447"];
  subtitle [pos="770,1450!", width=19.7222, height=0.4722, label="Features determine what to attend to; 3D distances determine where to attend", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=18, fontcolor="#4c5869"];
  single_input [pos="350,1370!", width=5.5556, height=0.9722, label="Single representation  s\n[B, N, c_s]", color="#3768a3", fillcolor="#eaf2fb"];
  geom_input [pos="875,1370!", width=6.3889, height=0.9722, label="Residue coordinate systems (R, t)\norientations + positions", color="#2e8578", fillcolor="#e6f3ef"];
  pair_input [pos="1320,1370!", width=4.3056, height=0.9722, label="Pair context\nz  or  (z₁, z₂)", color="#8360aa", fillcolor="#f1ebf8"];
  scalar_proj [pos="225,1250!", width=4.5833, height=0.9028, label="Linear\nscalar Q, K, V", color="#3768a3", fillcolor="#eaf2fb"];
  point_proj [pos="660,1250!", width=4.5833, height=0.9028, label="Linear\nlocal Q, K, V points", color="#2e8578", fillcolor="#e6f3ef"];
  to_global [pos="660,1140!", width=4.5833, height=0.9028, label="Local → global\np = R · p_local + t", color="#2e8578", fillcolor="#e6f3ef"];
  pair_proj [pos="1320,1250!", width=4.3056, height=0.9028, label="Pair projections", color="#8360aa", fillcolor="#f1ebf8"];
  scalar_score [pos="225,1015!", width=4.5833, height=0.9028, label="Scalar similarity\nscaled Q · K", color="#3768a3", fillcolor="#eaf2fb"];
  point_score [pos="750,1015!", width=6.1111, height=0.9028, label="Geometric similarity\n− weighted squared point distance", color="#2e8578", fillcolor="#e6f3ef"];
  pair_score [pos="1320,1015!", width=4.3056, height=0.9028, label="Pair bias", color="#8360aa", fillcolor="#f1ebf8"];
  logit_add [pos="750,905!", width=0.4167, height=0.4167, label="+", color="#4c5869", fillcolor="white", shape=circle, fontsize=25, penwidth=1.7];
  softmax [pos="750,815!", width=5.4167, height=0.9028, label="Mask + softmax over keys\na_ij  for each head", color="#4c5869", fillcolor="#f5f6f8"];
  attention_shape [pos="920,870!", width=4.1667, height=0.4167, label="weights: [B, H, N, N]", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=15, fontcolor="#4c5869"];
  scalar_aggregate [pos="225,685!", width=4.5833, height=0.9028, label="Σⱼ aᵢⱼ Vⱼ\nscalar values", color="#3768a3", fillcolor="#eaf2fb"];
  point_aggregate [pos="750,685!", width=5.4167, height=0.9028, label="Σⱼ aᵢⱼ pⱼ\nglobal value points", color="#2e8578", fillcolor="#e6f3ef"];
  pair_aggregate [pos="1320,685!", width=4.3056, height=0.9028, label="Σⱼ aᵢⱼ uᵢⱼ\nprojected pair values", color="#8360aa", fillcolor="#f1ebf8"];
  to_local [pos="750,570!", width=5.4167, height=0.9028, label="Global → query-local\np_local = Rᵢᵀ · (p − tᵢ)", color="#2e8578", fillcolor="#e6f3ef"];
  coords_norm [pos="750,465!", width=5.4167, height=0.8333, label="x, y, z coordinates + point norms", color="#2e8578", fillcolor="#e6f3ef"];
  concat [pos="750,365!", width=5.4167, height=0.8333, label="Concatenate heads + features", color="#4c5869", fillcolor="#f5f6f8"];
  out [pos="750,270!", width=5.4167, height=0.9028, label="Linear → residue update Δs\n[B, N, c_s]", color="#3768a3", fillcolor="#eaf2fb"];
  execution_title [pos="770,165!", width=18.0556, height=0.4444, label="ONE ATTENTION RULE · THREE EXECUTION BACKENDS", color="#263447", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=17, fontcolor="#263447"];
  native [pos="300,105!", width=5.9722, height=0.9028, label="native · JAX / XLA\nTiled attention + online softmax\nPortable: CPU · GPU · TPU", color="#3768a3", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=16, fontcolor="#3768a3"];
  fa3 [pos="790,105!", width=5.9722, height=0.9028, label="flash_attn3\nOptional NVIDIA FA3 kernel\nEligible GPU inputs", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=16, fontcolor="#4c5869"];
  aiter [pos="1260,105!", width=5.5556, height=0.9028, label="jax_aiter\nOptional AMD AITER kernel\nEligible GPU inputs", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=16, fontcolor="#4c5869"];
  footnote [pos="770,13!", width=20.5556, height=0.6389, label="Pair context is optional; uᵢⱼ denotes projected pair values (or their factorized equivalent).\nTiled / fused execution avoids storing full weights [B, H, N, N]; the attention rule is unchanged.", color="#4c5869", fillcolor="white", shape=plain, style="", fixedsize=false, fontsize=15, fontcolor="#4c5869"];
  single_input:s -> scalar_proj:n [color="#3768a3", arrowhead=normal];
