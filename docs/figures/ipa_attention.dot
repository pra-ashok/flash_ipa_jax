  route_62_1 [pos="225,815!", shape=point, width=0, height=0, label="", style=invis];
  route_60_0 -> route_62_1 [color="#4c5869", arrowhead=none];
  route_62_1 -> scalar_aggregate:n [color="#4c5869", arrowhead=normal];
  route_65_0 [pos="1060,815!", shape=point, width=0, height=0, label="", style=invis];
  softmax:e -> route_65_0 [color="#4c5869", arrowhead=none];
  route_67_1 [pos="1320,815!", shape=point, width=0, height=0, label="", style=invis];
  route_65_0 -> route_67_1 [color="#4c5869", arrowhead=none];
  route_67_1 -> pair_aggregate:n [color="#4c5869", arrowhead=normal];
  route_70_0 [pos="35,1250!", shape=point, width=0, height=0, label="", style=invis];
  scalar_proj:w -> route_70_0 [color="#3768a3", arrowhead=none];
  route_72_1 [pos="35,685!", shape=point, width=0, height=0, label="", style=invis];
